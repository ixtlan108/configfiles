#!/bin/bash

usage()
{
cat << EOF
usage: $0 options

OPTIONS:
   -h      Show this message
   -d      Dark mode 
   -l      Light mode (Default)
   -p      Place (Default: Ekebergveien)
EOF
}

ROOT="/Users/zeus/Projects/configfiles/wezterm"

CONFIG="/Users/zeus/.config/wezterm"

MODE=1
PLACE=1

#c)
#     CONTAINER_NAME=$OPTARG
#     ;;

while getopts "hdlp:" OPTION
do
     case $OPTION in
         h)
             usage
             exit 1
             ;;
         l)
             MODE=1
             ;;
         d)
             MODE=2
             ;;
         p)
             PLACE=$OPTARG
             ;;
         ?)
             usage
             exit
             ;;
     esac
done

echo "ROOT: $ROOT, MODE: $MODE, PLACE: $PLACE, CONFIG: $CONFIG"

if [ $MODE -eq 1 ]; then
        echo "$ROOT, Light mode"
        if [ $PLACE -eq 1 ]; then
            cp $ROOT/.wezterm.lua ~/.wezterm.lua 
        else
            cp $ROOT/.wezterm.lua $CONFIG/wezterm.lua 
        fi
else
        echo "$ROOT, Dark mode"
        if [ $PLACE -eq 1 ]; then
            cp $ROOT/.wezterm.lua.dark  ~/.wezterm.lua 
        else
            cp $ROOT/.wezterm.lua.dark $CONFIG/wezterm.lua
        fi
fi

exit 0
